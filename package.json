{
  "name": "@mediasuite/loopback-component-jsonapi",
  "description": "JSONAPI support for loopback",
  "version": "3.0.2",
  "main": "lib/index.js",
  "scripts": {
    "test": "mocha --reporter=spec ./test/**/*.test.js",
    "test:cov": "nyc mocha --reporter=spec ./test/**/*.test.js",
    "tester:otel": "OTEL_SERVICE_NAME=test OTEL_NODE_RESOURCE_DETECTORS='env,host,os' OTEL_TRACES_EXPORTER=otlp OTEL_OTLP_EXPORTER=http://127.0.0.1:4318 NODE_OPTIONS='--require @opentelemetry/auto-instrumentations-node/register' mocha --reporter=spec ./test/**/*.test.js",
    "lint": "prettier --write .",
    "semantic-release": "semantic-release"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mediasuitenz/loopback-component-jsonapi.git"
  },
  "keywords": [
    "loopback",
    "component",
    "jsonapi",
    "api",
    "json"
  ],
  "author": "Developers <developers@madecurious.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mediasuitenz/loopback-component-jsonapi/issues"
  },
  "homepage": "https://github.com/mediasuitenz/loopback-component-jsonapi#readme",
  "dependencies": {
    "body-parser": "^1.20.3",
    "debug": "^4.3.7",
    "http-status-codes": "^2.3.0",
    "inflection": "^2.0.1",
    "lodash": "^4.17.21",
    "type-is": "^1.6.14"
  },
  "devDependencies": {
    "chai": "^4.1.2",
    "loopback": "^3.0.0",
    "loopback-datasource-juggler": "^3.13.0",
    "mocha": "^6.2.3",
    "nyc": "^17.1.0",
    "prettier": "3.6.2",
    "rsvp": "4.7.0",
    "semantic-release": "^12.2.2",
    "superagent": "^10.2.3",
    "supertest": "^3.0.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.63.0"
  },
  "standard": {
    "globals": [
      "beforeEach",
      "it",
      "describe",
      "afterEach"
    ]
  },
  "engines": {
    "node": "^18.19.0 || >=20.6.0"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/@commitlint/prompt"
    }
  }
}
